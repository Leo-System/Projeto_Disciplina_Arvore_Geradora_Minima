{
  "openapi": "3.1.0",
  "info": {
    "title": "Árvore Geradora Mínima — Municípios de São Paulo",
    "description": "Sistema web local que modela a malha de municípios de São Paulo como grafo ponderado e calcula a árvore geradora mínima com Prim e Kruskal, ambos implementados do zero.",
    "version": "1.0.0"
  },
  "paths": {
    "/api/v1/cities": {
      "get": {
        "tags": [
          "árvore geradora mínima"
        ],
        "summary": "List Cities",
        "description": "Lista paginada de municípios, com filtro por nome e ordenação.\n\nRetorna o envelope ``{items, total, limit, offset}`` do PLAN §9, mais a\nchave ``cities`` (alias de ``items``) mantida por retrocompatibilidade\ncom o frontend e com os testes atuais. Sem parâmetros a resposta é a\nlista completa, como antes.",
        "operationId": "list_cities_api_v1_cities_get",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Filtro pelo nome do município, sem diferenciar maiúsculas nem acentos (ex.: 'sao' encontra 'São Paulo').",
              "title": "Q"
            },
            "description": "Filtro pelo nome do município, sem diferenciar maiúsculas nem acentos (ex.: 'sao' encontra 'São Paulo')."
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 1
                },
                {
                  "type": "null"
                }
              ],
              "description": "Máximo de itens da página. Omitido devolve a lista completa (comportamento antigo, usado pelo frontend).",
              "title": "Limit"
            },
            "description": "Máximo de itens da página. Omitido devolve a lista completa (comportamento antigo, usado pelo frontend)."
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "description": "Itens ignorados depois do filtro, antes do recorte da página.",
              "default": 0,
              "title": "Offset"
            },
            "description": "Itens ignorados depois do filtro, antes do recorte da página."
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "description": "Campo de ordenação: name, id, lat ou lon. Um '-' na frente inverte a ordem (ex.: -name).",
              "default": "name",
              "title": "Sort"
            },
            "description": "Campo de ordenação: name, id, lat ou lon. Um '-' na frente inverte a ordem (ex.: -name)."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CitiesResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
